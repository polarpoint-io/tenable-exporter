    {
      "id": 5,
      "type": "stat",
      "title": "Tenable Plugin Set Updated",
      "description": "Unix timestamp of the last Tenable plugin set update. Shows 'No data' if the exporter emits 0 (epoch) — this is an exporter-side issue, not a dashboard error.",
