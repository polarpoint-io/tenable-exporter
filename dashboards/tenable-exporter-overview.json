    {
      "id": 10,
      "type": "table",
      "title": "Top Failed Compliance Audits",
      "description": "Top failed compliance audit findings. Shows No data if the exporter is not configured to collect compliance results.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "topk(20, sum by (audit_name, provider, subscription_id) (tenable_compliance_findings_total{result=\"FAILED\",provider=~\"${provider:regex}\",subscription_id=~\"${subscription:regex}\"}))",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Count"
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Count",
              "audit_name": "Audit",
              "provider": "Provider",
              "subscription_id": "Subscription"
            }
          }
        }
      ]
    },
