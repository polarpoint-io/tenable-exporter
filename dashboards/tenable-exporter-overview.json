    {
      "id": 7,
      "type": "timeseries",
      "title": "Top 10 Subscriptions by Vulnerabilities",
      "description": "Open vulnerabilities per subscription. Requires Azure connector read permissions to resolve subscription IDs — shows No data if all IDs are 'unknown'.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "topk(10, sum by (provider, subscription_id) (tenable_vulnerabilities_by_subscription_total{provider=~\"${provider:regex}\",subscription_id=~\"${subscription:regex}\",severity=~\"${severity:regex}\",subscription_id!=\"unknown\"}))",
          "legendFormat": "{{provider}}/{{subscription_id}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 1,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "barAlignment": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        }
      }
    },
