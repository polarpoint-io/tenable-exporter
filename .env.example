TENABLE_ACCESS_KEY=your_access_key_here
TENABLE_SECRET_KEY=your_secret_key_here
EXPORTER_PORT=9190

# Scrape interval in seconds. Compliance exports are large — 300s minimum recommended.
SCRAPE_INTERVAL=300

# Optional: comma-separated providers to include (aws, azure, gcp)
# Leave empty to include all providers
TENABLE_FILTER_PROVIDERS=

# Optional: comma-separated subscription IDs to include
#   AWS   → account IDs        e.g. 123456789012,987654321098
#   Azure → subscription UUIDs e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   GCP   → project IDs        e.g. my-project-id
# Leave empty to include all subscriptions
TENABLE_FILTER_SUBSCRIPTIONS=
